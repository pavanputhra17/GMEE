# Copy to ROOT .env and fill all empty required fields locally.
# This template is not a secret and is NOT a usable production credential set.
# Do not commit .env or print resolved Compose configuration in logs.
POSTGRES_USER=gmee
POSTGRES_DB=gmee
# Use a generated URL-safe password (e.g. random hex) for Compose's URL assembly.
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=["http://localhost:3000"]
ENABLE_SCHEDULER=false
# Optional ingestion/LLM keys; omit providers you do not intend to use.
# NEWS_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
