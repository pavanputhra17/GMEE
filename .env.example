# GMEE Backend/Frontend Environment
# Copy to .env and adjust. Defaults work out of the box for dev.
# NEVER commit the real .env file.

# ---- Security (REQUIRED in production) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-key-change-me-at-least-32-chars-long!!
ACCESS_TOKEN_TTL_MINUTES=30

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://gmee:gmee@localhost:55432/gmee

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- Collectors (optional — pipeline skips disabled sources) ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEWS_API_KEY=

# ---- LLM (optional for dev; NLP claims extraction uses it) ----
ANTHROPIC_API_KEY=
