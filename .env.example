# GMEE Backend/Frontend Environment
# Copy to .env and adjust. Defaults work out of the box for dev.
# NEVER commit the real .env file.

# ---- Security (REQUIRED in production) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-key-change-me-at-least-32-chars-long!!
ACCESS_TOKEN_TTL_MINUTES=30

# ---- Database ----
# DATABASE_URL is used by Alembic (sync driver); POSTGRES_URL by the app (asyncpg).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:55432/gmee
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/gmee

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5050"]

# ---- Process model ----
# true (default): the API process owns the APScheduler (collection, NLP,
# evolution cycles) — right for dev / single-node. Set false for API-only
# replicas and run scripts/run_nlp_cycle.py etc. from a worker process.
ENABLE_SCHEDULER=true

# ---- Verdict engine calibration (optional) ----
# Cosine-similarity window in which two claims count as "the same assertion".
# Defaults 0.60-0.97 work well on general news; raise VERDICT_NEAR_MIN for
# stricter matching on large corpora.
# VERDICT_NEAR_MIN=0.60
# VERDICT_NEAR_MAX=0.97

# ---- Collectors (optional — pipeline skips disabled sources) ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEWS_API_KEY=

# ---- LLM (optional for dev; NLP claims extraction uses it) ----
ANTHROPIC_API_KEY=
