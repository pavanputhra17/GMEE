        ],
        "summary": "Trigger Evolution",
        "operationId": "trigger_evolution_api_v1_evolution_trigger_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "force",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Bypass debounce guard (minimum-corpus guard is still respected)",
              "default": false,
              "title": "Force"
            },
            "description": "Bypass debounce guard (minimum-corpus guard is still respected)"
