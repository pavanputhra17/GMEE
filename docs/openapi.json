Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/corpus/stats": {"get": {"tags": ["Corpus"], "summary": "Corpus Stats", "description": "Real corpus statistics for telemetry panels.", "operationId": "corpus_stats_api_v1_corpus_stats_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Corpus Stats Api V1 Corpus Stats Get"}}}}}}}, "/api/v1/corpus/search": {"get": {"tags": ["Corpus"], "summary": "Semantic Search", "description": "Nearest-neighbor article search via pgvector cosine distance.", "operationId": "semantic_search_api_v1_corpus_search_get", "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string", "minLength": 2, "maxLength": 300, "title": "Q"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 30, "minimum": 1, "default": 10, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Semantic Search Api V1 Corpus Search Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/corpus/articles/{article_id}": {"get": {"tags": ["Corpus"], "summary": "Article Detail", "operationId": "article_detail_api_v1_corpus_articles__article_id__get", "parameters": [{"name": "article_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Article Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Article Detail Api V1 Corpus Articles  Article Id  Get"}}}}, "422": {"description": "Validation Error", "content": {"appl