ema": {"type": "integer", "minimum": 0, "default": 0, "title": "Offset"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response List Verdicts Api V1 Verdicts Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/verdicts/stats": {"get": {"tags": ["Verdicts"], "summary": "Verdict Stats", "operationId": "verdict_stats_api_v1_verdicts_stats_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Verdict Stats Api V1 Verdicts Stats Get"}}}}}}}, "/api/v1/verdicts/leaderboard": {"get": {"tags": ["Verdicts"], "summary": "Outlet Leaderboard", "description": "Outlets ranked by Laplace-smoothed credibility over their verdicted claims.", "operationId": "outlet_leaderboard_api_v1_verdicts_leaderboard_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Outlet Leaderboard Api V1 Verdicts Leaderboard Get"}}}}}}}, "/api/v1/verdicts/game/mutations": {"get": {"tags": ["Verdicts"], "summary": "Mutation Chains", "description": "Claim mutation chains: same assertion, wording drifting outlet to\noutlet. Union-find over pgvector near-duplicate pairs (sim >= 0.90).", "operationId": "mutation_chains_api_v1_verdicts_game_mutations_get", "parameters": [{"name": "min_versions", "in": "query", "required": false, "schema": {"type": "integer", "default": 3, "title": "Min Versions"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 8, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Mutation Chains Api V1 Verdicts Game Mutations Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/verdicts/game/claim": {"get": {"tags": ["Verdicts"], "summary": "Game Claim", "description": "Random verdicted claim for Fact-or-Fake. Answer NOT included \u2014\nclient reveals via /verdicts/{id} so peeking requires effort :)", "operationId": "game_claim_api_v1_verdicts_game_claim_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Game Claim Api V1 Verdicts Game Claim Get"}}}}}}}, "/api/v1/verdicts/feedback": {"post": {"tags": ["Verdicts"], "summary": "Submit Verdict Feedback", "description": "Human-in-the-loop verdict correction.\n\nAGREE confirms the engine's band; DISAGREE optionally supplies the band\nthe human believes is correct. These labels are the ground truth for the\nengine's agreement metrics (GET /verdicts/summary) and future calibration.\nOne vote per (claim, client) \u2014 re-voting updates the previous vote.", "operationId": "submit_verdict_feedback_api_v1_verdicts_feedback_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/VerdictFeedbackBody"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Submit Verdict Feedback Api V1 Verdicts Feedback Post"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/verdicts/summary": {"get": {"tags": ["Verdicts"], "summary": "Verdict Summary", "description": "Engine-wide XAI summary: live distribution, full disclosed config,\nand human agreement metrics (the start of the evaluation loop).", "operationId": "verdict_summary_api_v1_verdicts_summary_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Verdict Summary Api V1 Verdicts Summary Get"}}}}}}}, "/api/v1/verdicts/{claim_id}": {"get": {"tags": ["Verdicts"], "summary": "Verdict Detail", "description": "Full transparency: the claim, its verdict, and EVERY factor.", "operationId": "verdict_detail_api_v1_verdicts__claim_id__get", "parameters": [{"name": "claim_id", "in": "path", "required": true, "schema": {"type": "string", "title": "Claim Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Verdict Detail Api V1 Verdicts  Claim Id  Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/graph/full": {"get": {"tags": ["Graph"], "summary": "Full Graph", "operationId": "full_graph_api_v1_graph_full_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"additionalProperties": true, "type": "object", "title": "Response Full Graph Api V1 Graph Full Get"}}}}}}}, "/api/v1/graph/claims": {"get": {"tags": ["Graph"], "summary": "Claims Graph", "description": "Claims network: persisted mutation edges, with a bounded pgvector fallback.\n\nEdges come from ``claim_relationships`` (EVOLVED_FROM / SIMILAR_TO rows the\nevolution pipeline already computed and indexed). Only when the selected\nclaims have no persisted links do we fall back to per-row HNSW KNN via a\nLATERAL join. The previous implementation ran a full claims\u00d7claims cross\njoin with a cosine-distance filter \u2014 ~20M distance computations per request\n(~120 s on the live corpus) while the UI polls this endpoint every 60 s.", "operationId": "claims_graph_api_v1_graph_claims_get", "parameters": [{"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 1200, "title": "Limit"}}, {"name": "threshold", "in": "query", "required": false, "schema": {"type": "number", "default": 0.86, "title": "Threshold"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Claims Graph Api V1 Graph Claims Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/graph/timeline": {"get": {"tags": ["Graph"], "summary": "Timeline Clusters", "description": "Story clusters ordered for the 3D timeline tunnel.\n\nEach ring = one hub story (most-linked article of its connected group),\nwith member articles from other outlets. Rings ALWAYS run newest-first\n(index 0 = nearest camera): the tunnel's wheel/click dive moves to higher\nindices, so scrolling deeper reads back through the coverage in time \u2014\nthe last ring is the original first report of the story.\n\nWhen ``article_id`` is provided, only clusters within 3 hops of that\narticle on SIMILAR edges are returned \u2014 used for the graph\u2192timeline\ndrill-down, so the tunnel shows the selected story alone.", "operationId": "timeline_clusters_api_v1_graph_timeline_get", "parameters": [{"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 60, "title": "Limit"}}, {"name": "article_id", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Article Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Timeline Clusters Api V1 Graph Timeline Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/graph/scoops": {"get": {"tags": ["Graph"], "summary": "Scoop Races", "description": "Who broke each story first? For every linked cluster: outlets ranked\nby publish time with exact lag behind the winner.", "operationId": "scoop_races_api_v1_graph_scoops_get", "parameters": [{"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "default": 12, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Scoop Races Api V1 Graph Scoops Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/graph/simulate": {"get": {"tags": ["Graph"], "summary": "Simulate Spread", "description": "Propagation sandbox: if each cross-outlet SIMILAR edge transmits the\nstory with probability p, how far does this story spread from `hub`?\nFirst-order branching approximation over the real article graph.", "operationId": "simulate_spread_api_v1_graph_simulate_get", "parameters": [{"name": "hub", "in": "query", "required": true, "schema": {"type": "string", "title": "Hub"}}, {"name": "p", "in": "query", "required": false, "schema": {"type": "number", "default": 0.5, "title": "P"}}, {"name": "max_depth", "in": "query", "required": false, "schema": {"type": "integer", "default": 3, "title": "Max Depth"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true, "title": "Response Simulate Spread Api V1 Graph Simulate Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/api/v1/graph/lineage/{claim_id}": {"